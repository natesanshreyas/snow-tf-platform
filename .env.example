# ── LLM (required — pick one) ────────────────────────────────────────────────

# Option A: Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Option B: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o        # default

# Option C: local dev with no real LLM (returns hardcoded responses)
# MOCK_LLM=true

# ── GitHub (optional) ────────────────────────────────────────────────────────
# Without this, DEMO_MODE stubs all GitHub API calls.
# With it, the demo creates a real branch + files + PR in terraform-demo-app.
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# ── ServiceNow (optional) ────────────────────────────────────────────────────
# Without this, DEMO_MODE stubs all SNOW work note writes.
# SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
# SERVICENOW_USER=admin
# SERVICENOW_PASSWORD=...

# ── Platform ─────────────────────────────────────────────────────────────────
GITHUB_ORG=your-github-org
GITHUB_MODULES_REPO=terraform-azure-modules
DEFAULT_ENVIRONMENT=dev
FRONTEND_URL=http://localhost:3000

# Set to false when GITHUB_PERSONAL_ACCESS_TOKEN and SERVICENOW credentials are configured
DEMO_MODE=true
